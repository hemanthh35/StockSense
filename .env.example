POSTGRES_USER=stocksense
POSTGRES_PASSWORD=stocksense
POSTGRES_DB=stocksense

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720

# Brevo (https://app.brevo.com -> SMTP & API -> API Keys). Sender must be a verified sender in Brevo.
# If BREVO_API_KEY is empty, the OTP is printed in the backend logs instead of emailed (dev fallback).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=StockSense

# --- Part 2: security & access ---
# development | production. Production refuses to start with a placeholder or short SECRET_KEY.
APP_ENV=development
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Rate limits on login / sign-up / password reset (per person and per address).
RATE_LIMIT_ENABLED=true
# Daily low-stock email: on/off and the hour (UTC) after which it is sent.
DIGEST_ENABLED=true
DIGEST_HOUR_UTC=3

# --- AI assistant (Groq, OpenAI-compatible). Leave GROQ_API_KEY empty to disable it. ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ASSISTANT_RATE_PER_MINUTE=20
