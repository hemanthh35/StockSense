POSTGRES_USER=stocksense
POSTGRES_PASSWORD=stocksense
POSTGRES_DB=stocksense

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720

# Brevo (https://app.brevo.com -> SMTP & API -> API Keys). Sender must be a verified sender in Brevo.
# If BREVO_API_KEY is empty, the OTP is printed in the backend logs instead of emailed (dev fallback).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=StockSense
